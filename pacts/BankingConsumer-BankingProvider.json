{
  "consumer": {
    "name": "BankingConsumer"
  },
  "interactions": [
    {
      "description": "a request for account details",
      "providerStates": [
        {
          "name": "an account exists"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/accounts/12345"
      },
      "response": {
        "body": {
          "accountId": "12345",
          "balance": 2500,
          "currency": "INR"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "status": 200
      }
    },
    {
      "description": "a request to create an account",
      "providerStates": [
        {
          "name": "account 12346 does not exist"
        }
      ],
      "request": {
        "body": {
          "accountId": "12346",
          "balance": 3200,
          "currency": "INR"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "method": "POST",
        "path": "/accounts"
      },
      "response": {
        "body": {
          "accountId": "12346",
          "balance": 3200,
          "currency": "INR"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "status": 201
      }
    },
    {
      "description": "a request to delete an account",
      "providerStates": [
        {
          "name": "account 10020 exists"
        }
      ],
      "request": {
        "method": "DELETE",
        "path": "/accounts/10020"
      },
      "response": {
        "body": {
          "accountId": "10020",
          "message": "Account deleted successfully"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "status": 200
      }
    },
    {
      "description": "a request to update an account balance",
      "providerStates": [
        {
          "name": "account 10001 exists with balance 2500 INR"
        }
      ],
      "request": {
        "body": {
          "balance": 4000
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "method": "PUT",
        "path": "/accounts/10001"
      },
      "response": {
        "body": {
          "accountId": "10001",
          "balance": 4000,
          "currency": "INR"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "status": 200
      }
    },
    {
      "description": "a request to update an account currency",
      "providerStates": [
        {
          "name": "account 10002 exists with balance 5000 INR"
        }
      ],
      "request": {
        "body": {
          "currency": "USD"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "method": "PATCH",
        "path": "/accounts/10002"
      },
      "response": {
        "body": {
          "accountId": "10002",
          "balance": 5000,
          "currency": "USD"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "status": 200
      }
    }
  ],
  "metadata": {
    "pact-js": {
      "version": "17.1.4"
    },
    "pactRust": {
      "ffi": "0.5.8",
      "models": "1.3.16"
    },
    "pactSpecification": {
      "version": "3.0.0"
    }
  },
  "provider": {
    "name": "BankingProvider"
  }
}